local function parseTime(str)
    local d, h, m, s = str:match("(%d+)일%s*(%d+)시%s*(%d+)분%s*(%d+)초")
    if d then return tonumber(d), tonumber(h), tonumber(m), tonumber(s) end
    local h2, m2, s2 = str:match("(%d+)시간%s*(%d+)분%s*(%d+)초")
    if h2 then return 0, tonumber(h2), tonumber(m2), tonumber(s2) end
    return 0, 0, 0, 0
end

local function formatTime(d, h, m, s, hasDay)
    if hasDay then
        return string.format("%02d일 %02d시 %02d분 %02d초", d, h, m, s)
    else
        return string.format("%02d시간 %02d분 %02d초", h, m, s)
    end
end

local function addRadar(isTotal, amount)
    local t = box3.Text
    local total, weekly = t:match("총합 레이더 처치 (%d+) · 주간 레이더 처치 (%d+)")
    if total and weekly then
        if isTotal then
            total = tonumber(total) + amount
        else
            weekly = tonumber(weekly) + amount
        end
        box3.Text = string.format("총합 레이더 처치 %d · 주간 레이더 처치 %d", total, weekly)
    end
end

btnRadar1.MouseButton1Click:Connect(function() addRadar(true, 1) end)
btnRadar2.MouseButton1Click:Connect(function() addRadar(false, 1) end)

task.spawn(function()
    while true do
        task.wait(1)
        if isRunning then
            local d1, h1, m1, s1 = parseTime(box1.Text)
            s1 = s1 + 1
            if s1 >= 60 then s1 = 0; m1 = m1 + 1 end
            if m1 >= 60 then m1 = 0; h1 = h1 + 1 end
            if h1 >= 24 then h1 = 0; d1 = d1 + 1 end
            box1.Text = formatTime(d1, h1, m1, s1, true)

            local _, h2, m2, s2 = parseTime(box2.Text)
            s2 = s2 + 1
            if s2 >= 60 then s2 = 0; m2 = m2 + 1 end
            if m2 >= 60 then m2 = 0; h2 = h2 + 1 end
            box2.Text = formatTime(0, h2, m2, s2, false)
        end
    end
end)

