local dragging, dragInput, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)
MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
MainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

StartBtn.MouseButton1Click:Connect(function()
    if not selectedProductId then return end
    StartBtn.Text = "기다려..."
    
    -- [수정] 시작하기 누를 때 서버 로그 API를 안전한 HttpGet으로 호출
    pcall(function()
        local prodName = productNames[selectedProductId] or selectedProductId
        game:HttpGet(API_URL .. "/api/log?roblox=" .. RobloxName .. "&product=" .. HttpService:UrlEncode(prodName), true)
    end)
    
    local fetchUrl = API_URL .. "/api/script?roblox=" .. RobloxName .. "&product=" .. selectedProductId
    local s, scriptBody = pcall(function() return game:HttpGet(fetchUrl, true) end)
    
    if s and scriptBody and scriptBody ~= "" then
        TweenService:Create(MainFrame, tweenInfoSmooth, {Size = UDim2.new(0, 600, 0, 350), Position = UDim2.new(0.5, -300, 0.5, -175), BackgroundTransparency = 1}):Play()
        
        for _, obj in pairs(MainFrame:GetDescendants()) do
            local props = {}
            if obj:IsA("TextLabel") or obj:IsA("TextButton") then 
                props.TextTransparency = 1 
                props.BackgroundTransparency = 1
            elseif obj:IsA("ImageLabel") then 
                props.ImageTransparency = 1 
                props.BackgroundTransparency = 1
            elseif obj:IsA("ScrollingFrame") then 
                props.ScrollBarImageTransparency = 1 
                props.BackgroundTransparency = 1
            elseif obj:IsA("Frame") then
                props.BackgroundTransparency = 1
            elseif obj:IsA("UIStroke") then 
                props.Transparency = 1 
            end
            
            local hasProps = false
            for k, v in pairs(props) do hasProps = true break end
            
            if hasProps then
                TweenService:Create(obj, tweenInfoFast, props):Play()
            end
        end
        
        task.wait(0.4)
        ScreenGui:Destroy() 
        
        local loadFunc, loadErr = loadstring(scriptBody)
        if loadFunc then
            loadFunc()
        else
            warn("스크립트 실행 에러: " .. tostring(loadErr))
        end
    else
        StartBtn.Text = "스크립트가 없거나 고장났거나 실패함."
        StartBtn.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
        task.wait(1.5)
        StartBtn.Text = "시작하기"
        StartBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 128)
    end
end)
