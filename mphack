local timeData = {
    d1 = 0, h1 = 0, m1 = 0, s1 = 0,
    h2 = 0, m2 = 0, s2 = 0,
    radarTotal = 0,
    radarWeekly = 0
}

local activeLock = false

local function startLockLoop()
    if activeLock then return end
    activeLock = true

    game:GetService("RunService").RenderStepped:Connect(function()
        local text1 = string.format("%02d일 %02d시 %02d분 %02d초", timeData.d1, timeData.h1, timeData.m1, timeData.s1)
        local text2 = string.format("%02d시 %02d분 %02d초", timeData.h2, timeData.m2, timeData.s2)
        local text3 = string.format("총합 레이더 처치 %d · 주간 레이더 처치 %d", timeData.radarTotal, timeData.radarWeekly)

        for _, gui in ipairs(workspace:GetDescendants()) do
            if gui:IsA("SurfaceGui") then
                for _, lbl in ipairs(gui:GetDescendants()) do
                    if lbl:IsA("TextLabel") then
                        if string.find(lbl.Text, "일") and string.find(lbl.Text, "시") and string.find(lbl.Text, "분") then
                            lbl.Text = text1
                        elseif (string.find(lbl.Text, "시간") or string.find(lbl.Text, "시")) and string.find(lbl.Text, "분") and not string.find(lbl.Text, "총합") then
                            lbl.Text = text2
                        elseif string.find(lbl.Text, "레이더") then
                            lbl.Text = text3
                        end
                    end
                end
            end
        end
    end)
end

-- 플러스/마이너스 조작 행 생성 함수
local function createPlusMinusRow(posY, labelText, keys)
    local sectionLbl = Instance.new("TextLabel")
    sectionLbl.Size = UDim2.new(0.9, 0, 0, 18)
    sectionLbl.Position = UDim2.new(0.05, 0, 0, posY)
    sectionLbl.BackgroundTransparency = 1
    sectionLbl.TextColor3 = Color3.fromRGB(180, 180, 190)
    sectionLbl.Text = labelText
    sectionLbl.TextSize = 11
    sectionLbl.Font = Enum.Font.Gotham
    sectionLbl.TextXAlignment = Enum.TextXAlignment.Left
    sectionLbl.Parent = frame

    local units = {"1일", "1시", "1분", "01초"}
    if #keys == 3 then
        units = {"", "1시", "1분", "01초"}
    end

    for i = 1, 4 do
        if keys[i] == nil then continue end
        local key = keys[i]

        -- 마이너스(-) 버튼
        local btnMinus = Instance.new("TextButton")
        btnMinus.Size = UDim2.new(0.10, 0, 0, 22)
        btnMinus.Position = UDim2.new(0.05 + (i-1) * 0.23, 0, 0, posY + 20)
        btnMinus.BackgroundColor3 = Color3.fromRGB(70, 45, 50)
        btnMinus.TextColor3 = Color3.fromRGB(255, 180, 180)
        btnMinus.Text = "-"
        btnMinus.TextSize = 12
        btnMinus.Font = Enum.Font.GothamBold
        btnMinus.Parent = frame
        
        local cornerM = Instance.new("UICorner")
        cornerM.CornerRadius = UDim.new(0, 4)
        cornerM.Parent = btnMinus
        
        btnMinus.MouseButton1Click:Connect(function()
            timeData[key] = math.max(0, timeData[key] - 1)
            startLockLoop()
        end)

        -- 플러스(+) 버튼
        local btnPlus = Instance.new("TextButton")
        btnPlus.Size = UDim2.new(0.11, 0, 0, 22)
        btnPlus.Position = UDim2.new(0.16 + (i-1) * 0.23, 0, 0, posY + 20)
        btnPlus.BackgroundColor3 = Color3.fromRGB(45, 65, 55)
        btnPlus.TextColor3 = Color3.fromRGB(180, 255, 180)
        btnPlus.Text = units[i] ~= "" and units[i] .. "+" or "+"
        btnPlus.TextSize = 10
        btnPlus.Font = Enum.Font.GothamBold
        btnPlus.Parent = frame
        
        local cornerP = Instance.new("UICorner")
        cornerP.CornerRadius = UDim.new(0, 4)
        cornerP.Parent = btnPlus
        
        btnPlus.MouseButton1Click:Connect(function()
            timeData[key] = timeData[key] + 1
            startLockLoop()
        end)
    end
end

createPlusMinusRow(50, "-- 총합 플레이시간 조작", {"d1", "h1", "m1", "s1"})
createPlusMinusRow(120, "-- 일일 플레이시간 조작", {nil, "h2", "m2", "s2"})

