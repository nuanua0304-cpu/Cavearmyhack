local function updateTeamButtons()
    local teamsList = Teams:GetTeams()
    local buttonWidth = (410 / math.max(#teamsList, 1)) - 5
    
    for i, team in ipairs(teamsList) do
        local teamBtn = Instance.new("TextButton")
        teamBtn.Size = UDim2.new(0, buttonWidth, 0, 24)
        teamBtn.Position = UDim2.new(0, 10 + (i - 1) * (buttonWidth + 5), 0, 308)
        teamBtn.BackgroundColor3 = team.TeamColor.Color
        teamBtn.BorderSizePixel = 0
        teamBtn.Text = team.Name
        teamBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        teamBtn.TextSize = 11
        teamBtn.Font = Enum.Font.GothamBold
        teamBtn.Parent = frame
        
        local bCorner = Instance.new("UICorner")
        bCorner.CornerRadius = UDim.new(0, 4)
        bCorner.Parent = teamBtn
        
        teamBtn.MouseButton1Click:Connect(function()
            pcall(function()
                for _, gui in ipairs(player.PlayerGui:GetDescendants()) do
                    if gui:IsA("TextButton") or gui:IsA("TextLabel") or gui:IsA("ImageButton") then
                        if gui.Text == team.Name or gui.Name == team.Name then
                            local target = gui
                            if not target:IsA("TextButton") and not target:IsA("ImageButton") and target.Parent and (target.Parent:IsA("TextButton") or target.Parent:IsA("ImageButton")) then
                                target = target.Parent
                            end
                            
                            if target and (target:IsA("TextButton") or target:IsA("ImageButton")) then
                                for _, conn in ipairs(getconnections(target.MouseButton1Click)) do
                                    conn:Fire()
                                end
                                for _, conn in ipairs(getconnections(target.MouseButton1Down)) do
                                    conn:Fire()
                                end
                                for _, conn in ipairs(getconnections(target.Activated)) do
                                    conn:Fire()
                                end
                            end
                        end
                    end
                end
            end)
        end)
    end
end

updateTeamButtons()
